# MkDocs ビルド成果物
site/

# Quarto ビルドキャッシュ（中間ファイル）
quarto/.quarto/
# docs/quarto/ は Quarto の出力先 → git 管理（MkDocs が静的ファイルとして配信）
# _freeze/ は CI 用にコミット対象（freeze: auto に必要）

# TeX 中間ファイル（out/main.pdf は残す）
tex/out/*.aux
tex/out/*.log
tex/out/*.fls
tex/out/*.fdb_latexmk
tex/out/*.synctex.gz
tex/out/*.bbl
tex/out/*.blg
tex/out/*.toc
tex/out/*.out
tex/out/*.bcf
tex/out/*.run.xml

# Python
__pycache__/
*.pyc
.env

# OS
.DS_Store
